# ==============================================================================
# Qite — Skripsi Scout AI (.env.example)
# AI Research Assistant for Thesis Analysis, Academic Search & Smart Citations
# ==============================================================================

# [1] GROQ API Configuration (Free Tier supported)
# Dapatkan API Key gratis di https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Model yang direkomendasikan dan aktif di Groq saat ini:
# - openai/gpt-oss-20b (Sangat cepat, reasoning kuat, json mode)
# - openai/gpt-oss-120b (Sangat cerdas untuk analisis akademis mendalam)
# - qwen/qwen3.8-27b (Bilingual Indonesia/Inggris sangat akurat)
GROQ_MODEL=openai/gpt-oss-20b

# [2] ACADEMIC SEARCH APIS
# OpenAlex API (Gratis, tanpa auth atau sertakan email/api key untuk polite pool)
# Dokumentasi: https://docs.openalex.org/
OPENALEX_API_KEY=
OPENALEX_EMAIL=your-academic-email@example.com

# Crossref API (Gratis polite pool dengan menyertakan email Anda)
# Dokumentasi: https://api.crossref.org/swagger-ui/index.html
CROSSREF_MAILTO=your-academic-email@example.com

# [3] SUPABASE (Database PostgreSQL & Auth - Opsional untuk sinkronisasi cloud)
# Dapatkan di https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# [4] GOOGLE ADSENSE (Opsional — untuk monetisasi)
# Dapatkan di https://www.google.com/adsense/
# Cukup CLIENT_ID saja sudah aktif (Auto Ads). SLOT_ID opsional untuk unit spesifik.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# [5] APP CONFIGURATION
NEXT_PUBLIC_APP_NAME="Qite — Skripsi Scout AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000
